DATABASE_URL=postgresql+psycopg://miniflow:miniflow@localhost:5432/miniflow
APP_NAME=MiniFlow API
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000

# Rate limiting for auth routes (slowapi syntax, e.g. "10/minute").
AUTH_RATE_LIMIT=10/minute

# Password reset.
# FRONTEND_URL is the web app's base URL; reset links point at
# {FRONTEND_URL}/reset-password. Set it to your Vercel URL in production.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
# Email delivery is pluggable. With nothing set the reset link is written to
# the server log (fine for local dev / a demo deploy). Set RESEND_API_KEY for
# Resend's HTTP API, or the SMTP_* vars for SMTP. EMAIL_FROM is the sender.
EMAIL_FROM=MiniFlow <no-reply@miniflow.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AI subtask generation — any OpenAI-compatible provider.
# Get a free key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b:free
LLM_BASE_URL=https://openrouter.ai/api/v1

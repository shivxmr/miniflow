DATABASE_URL=postgresql+psycopg://miniflow:miniflow@localhost:5432/miniflow
APP_NAME=MiniFlow API
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000

# Rate limiting for auth routes (slowapi syntax, e.g. "10/minute").
AUTH_RATE_LIMIT=10/minute

# AI subtask generation — any OpenAI-compatible provider.
